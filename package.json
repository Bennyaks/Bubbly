{
  "name": "zeva",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "^57.0.26",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "firebase": "^9.14.0",
    "react": "^19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backend:install": "npm install --prefix functions",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "emulators:fresh": "firebase emulators:start --export-on-exit=./emulator-data",
    "test": "node --test \"functions/test/*.test.js\" \"src/tests/*.test.js\"",
    "test:rules": "npm install --prefix tests && firebase emulators:exec --only firestore,storage --project demo-zeva \"node --test tests/rules.test.js\"",
    "test:all": "npm test && npm run test:rules",
    "smoke": "node scripts/smoke.js",
    "deploy:dev": "firebase deploy --project dev",
    "deploy:prod": "firebase deploy --project prod"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3"
  }
}
